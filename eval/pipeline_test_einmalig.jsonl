{"zeit": "2026-10-03T13:30:29", "antwort_id": "5e439601ebd64c2a", "pseudonym": "767a98471550b5870e63409c01ed7340", "frage_id": "T03", "sprache": "de", "modell": "gemini-3.1-flash-lite", "reranker": null, "k": 10, "entscheid": "beantwortet", "antwort": "Anspruch auf eine Zufahrtsbewilligung haben gemäss SRS 7.7.5-3 § 5 Abs. 1 folgende Personen: Anwohnende, die bei der Einwohnerkontrolle der Stadt Zug gemeldet sind (im Fall der Zufahrtsbewilligung Zugerberg zusätzlich deren Kinder sowie Partnerinnen und Partner), Mieterinnen bzw. Mieter eines im betroffenen Gebiet befindlichen Parkplatzes, Eigentümerinnen bzw. Eigentümer eines nur über ein öffentlich-rechtliches Fahrverbot erreichbaren Grundstücks, Berechtigte an einem im Grundbuch eingetragenen Fahrwegrecht sowie Personen, die aus wichtigen Gründen in ein Fahrverbot oder eine Strasse mit einer Benützungsbeschränkung einfahren müssen. Die Erteilung setzt ein schriftliches Gesuch voraus und darf nicht durch überwiegende öffentliche Interessen ausgeschlossen sein (SRS 7.7.5-3 § 5 Abs. 2 und 3). Zudem ist bei privaten Strassen und Wegen innerhalb eines öffentlich-rechtlichen Fahrverbots das Einverständnis der privaten Strasseneigentümerschaft erforderlich (SRS 7.7.5-3 § 4 Abs. 1).", "quellen": ["web:de/mobilitaet/zufahrtsbewilligung#0", "law:7.7.5-3#6", "law:7.7.5-3#3", "law:7.7.5-3#4", "law:7.7.5-3#2", "law:7.7.5-3#9", "law:7.7.5-2#11", "law:7.7.5-3#8", "law:7.7.5-1#1", "law:7.7.5-2#17", "law:7.7.5-1#4", "law:7.7.1-1#22"], "bm25_nachzug": ["law:7.7.5-1#4", "law:7.7.1-1#22"], "benutzte_quellen": ["law:7.7.5-3#3", "law:7.7.5-3#4"], "s1": 0.7151, "s2": 1.0, "s3": 1.0, "confidence_vorlaeufig": 0.9145, "confidence_kalibriert": false, "eskalationsgruende": [], "retrieval_warnung": false, "retrieval": {"s1": 0.7151, "top3_mittel": 0.6493, "marge": 0.101}, "vollstaendigkeit": {"ok": true, "status": "keine_gebuehrenfrage"}, "grounding_urteil": "gedeckt", "grounding_grund": "beide_schichten", "coverage": {"ok": true, "typen": [],