{"zeit": "2026-10-03T13:30:54", "antwort_id": "55e7bc0316074e32", "pseudonym": "dbe4b366b108821ce5412546271ac84a", "frage_id": "T05", "sprache": "de", "modell": "gemini-3.1-flash-lite", "reranker": null, "k": 10, "entscheid": "beantwortet", "antwort": "Die Gebührenpflicht für oberirdische öffentliche Parkplätze in der Stadt Zug hängt von der Art der Bewirtschaftung ab: Monetär und zeitlich bewirtschaftete Parkplätze sind von Montag bis Samstag von 07.00 Uhr bis 19.00 Uhr gebührenpflichtig, ausgenommen Feiertage (SRS 7.7.5-2 § 3 Abs. 2). Parkplätze mit ausschliesslich zeitlicher Bewirtschaftung sind von Montag bis Freitag von 07.00 Uhr bis 19.00 Uhr gebührenpflichtig, ausgenommen Feiertage (SRS 7.7.5-2 § 3 Abs. 2 bis). In der Umgebung von öffentlichen Freizeit- und Sportanlagen kann die zeitliche Bewirtschaftung zudem auf Samstage, Sonntage sowie Feiertage von 07.00 Uhr bis 19.00 Uhr ausgeweitet werden (SRS 7.7.5-2 § 3 Abs. 2 ter).", "quellen": ["web:de/mobilitaet/parkieren#0", "web:de/mobilitaet/baustellen#0", "law:7.7.5-2#1", "law:7.7.5-2#13", "law:7.7.5-1#1", "law:7.7.5-2#8", "law:9.5-4#5", "law:7.7.5-3#1", "pdf:dam_jcr_1477b3b8_f5dc_428b_8803_b9c7ecf1aadf_Taxipr_C3_BCfung_Brosch_C3_BCre_A4__2ee245.pdf#15", "web:de/ueber-die-stadt-zug/ortspflege/strassenbau-unterhalt#0", "law:7.7.5-2#2", "web:de/ueber-die-stadt-zug/ortspflege/abfallentsorgung#0"], "bm25_nachzug": ["law:7.7.5-2#2", "web:de/ueber-die-stadt-zug/ortspflege/abfallentsorgung#0"], "benutzte_quellen": ["law:7.7.5-2#2"], "s1": 0.6977, "s2": 1.0, "s3": 1.0, "confidence_vorlaeufig": 0.9093, "confidence_kalibriert": false, "eskalationsgruende": [], "retrieval_warnung": false, "retrieval": {"s1": 0.6977, "top3_mittel": 0.6443, "marge": 0.1005}, "vollstaendigkeit": {"ok": true, "status": "keine_zeiteinheit_in_der_frage"}, "grounding_urteil": "gedeckt", "grounding_grund": "beide_schichten", "coverage": {"ok": true, "typen": ["gebuehr", "zeit"], "luecken": [], "nur_eine_quellenart": false, "quellenarten_mit_betra