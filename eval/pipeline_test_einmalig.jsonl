{"zeit": "2026-10-03T13:33:41", "antwort_id": "256210ffc9cd4824", "pseudonym": "3a24ec22567550decfa98f6682cb15f4", "frage_id": "T18", "sprache": "de", "modell": "gemini-3.1-flash-lite", "reranker": null, "k": 10, "entscheid": "beantwortet", "antwort": "Nein, das ist nicht korrekt. Der Besitz einer Anwohnerparkkarte gibt keinen Anspruch auf einen freien Parkplatz (SRS 7.7.5-2 § 11 Abs. 1). Zudem berechtigt die Bewilligung lediglich zum Parkieren im Rahmen der geltenden Vorschriften, ohne dass die Stadt eine Haftung für Beschädigungen oder Diebstahl übernimmt (SRS 7.7.5-1 § 3 Abs. 1).", "quellen": ["law:7.7.5-2#15", "law:7.7.5-2#10", "web:de/mobilitaet/parkieren#4", "law:7.7.5-2#19", "law:7.7.5-2#11", "web:de/mobilitaet/parkieren#3", "law:7.1-1.5#9", "law:7.1-1.5#12", "pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#75", "law:7.7.5-1#2", "pdf:dam_jcr_5fa9a780_67c0_41af_a208_a30b1c81da83_Broschuere_Anschluss_finden_pdf_6debce.pdf#1", "law:7.7.5-2#12"], "bm25_nachzug": ["pdf:dam_jcr_5fa9a780_67c0_41af_a208_a30b1c81da83_Broschuere_Anschluss_finden_pdf_6debce.pdf#1", "law:7.7.5-2#12"], "benutzte_quellen": ["law:7.7.5-2#10", "law:7.7.5-1#2"], "s1": 0.6552, "s2": 1.0, "s3": 1.0, "confidence_vorlaeufig": 0.8966, "confidence_kalibriert": false, "eskalationsgruende": [], "retrieval_warnung": true, "retrieval": {"s1": 0.6552, "top3_mittel": 0.6471, "marge": 0.0168}, "vollstaendigkeit": {"ok": true, "status": "keine_gebuehrenfrage"}, "grounding_urteil": "gedeckt", "grounding_grund": "beide_schichten", "coverage": {"ok": true, "typen": [], "luecken": [], "nur_eine_quellenart": false, "quellenarten_mit_betrag": ["erlass", "web"]}, "coverage_ergaenzung": {"typen": [], "ergaenzt": [], "status": "nicht_anwendbar"}, "rueckfrage": false, "unvollstaendig": false, "tokens": {"prompt_tokens": 5261, "output_tokens": 173, "versuche": 1, "modell": "gemini-3.1-flash-lite"}, "dauer_s": 4.31}
{"zeit": "2026-10-03T13:33:58", "antwort_id": "e8184d380d7745dc", "pseudonym": "79321c59b84137fbb9d64b76fa9d32bf", "frage_id": "T19", "sprache": "en", "modell": "gemini-3.1-flash-lite", "reranker": null, "k": 10, "entscheid": "beantwortet", "antwort": "Yes, you require an official permit to regularly park automobiles or automobile trailers (such as caravans or cargo trailers) overnight on public ground or generally accessible municipal parking spaces (SRS 7.7.5-1 § 1). Regular parking is defined as parking a vehicle more than four times over a period of 30 consecutive working days (SRS 7.7.5-2 § 10). The monthly fees for this permit are: CHF 30.00 for light motor vehicles under 3.5 t (category B), trailers for light motor vehicles, and three-wheeled motor vehicles; and CHF 60.00 for heavy motor vehicles over 3.5 t (including coaches) and trailers for heavy motor vehicles (SRS 7.7.5-2 § 10). The permit is managed by the Department of Safety and Traffic (Abteilung Sicherheit und Verkehr) (SRS 7.7.5-1 § 9).\n\nPlease note: this English answer is not legally binding. The official language of the City of Zug is German; the German sources cited above are authoritative.", "quellen": ["law:7.7.5-1#4", "web:de/mobilitaet/parkieren#6", "law:7.7.5-1#0", "law:7.7.5-2#9", "law:7.7.5-1#2", "law:7.7.5-2#11", "law:7.7.5-1#3", "law:7.7.5-1#5", "law:7.7.5-1#7", "web:de/mobilitaet/parkieren#7", "pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#66", "law:7.7.1-1#2"], "bm25_nachzug": ["pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#66", "law:7.7.1-1#2"], "benutzte_quellen": [], "s1": 0.7208, "s2": 1.0, "s3": 1.0, "confidence_vorlaeufig": 0.9162, "confidence_kalibriert": false, "eskalationsgruende": [], "retrieval_warnung": false, "retrieval": {"s1": 0.7208, "top3_mittel": 0.7128, "marge": 0.0277}, "vollstaendigkeit": {"ok": true, "status": "keine_gebuehrenfrage"}, "grounding_urteil": "gedeckt