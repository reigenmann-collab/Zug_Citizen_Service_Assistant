{"zeit": "2026-10-03T10:39:10", "pseudonym": "0a4ba20970d61256a2361d17dd9f35c7", "frage_id": "D19", "sprache": "de", "modell": "gemini-3.1-flash-lite", "reranker": null, "k": 10, "entscheid": "beantwortet", "antwort": "Es gibt verschiedene Arten von Parkkarten, je nach Ihrem Bedarf. Für Anwohnende in den Quartieren kostet die Parkkarte monatlich CHF 30.- (bei bereits bezahlter Nachtparkgebühr) oder CHF 60.- (inklusive Nachtparkgebühr) [Q3, Q7]. Gewerbetreibende, Ärzte, Spitexdienste oder Behindertentransportdienste können eine Gewerbeparkkarte beziehen, die CHF 6.- pro Tag, CHF 60.- für 30 Tage oder CHF 600.- pro Jahr kostet [Q1, Q9]. Zudem können Anwohnende für Besuchende Tageskarten für CHF 5.- pro Tag erwerben [Q3]. Bitte geben Sie an, ob Sie eine Anwohner- oder Gewerbeparkkarte benötigen, damit ich Ihnen die passenden Details nennen kann.", "quellen": ["web:de/mobilitaet/parkieren#11", "law:7.7.5-2#15", "web:de/mobilitaet/parkieren#9", "web:de/mobilitaet/parkieren#8", "web:de/mobilitaet/parkieren#2", "law:7.1-1.5#9", "law:7.7.5-2#12", "pdf:dam_jcr_37a10ad4_2f3f_4bcf_b731_abefdb4a6f5e_Publ_2018_AC_Laden_StepbyStep_pdf_bbac2b.pdf#0", "law:7.7.5-2#14", "web:de/mobilitaet/parkieren#15"], "benutzte_quellen": ["web:de/mobilitaet/parkieren#11", "web:de/mobilitaet/parkieren#9", "law:7.7.5-2#12", "law:7.7.5-2#14"], "s1": 0.5802, "s2": 1.0, "s3": 0.8, "confidence_vorlaeufig": 0.8141, "grounding_urteil": "gedeckt", "grounding_grund": "beide_schichten", "coverage": {"ok": true, "typen": [], "luecken": [], "nur_eine_quellenart": false, "quellenarten_mit_betrag": ["erlass", "web"]}, "coverage_ergaenzung": {"typen": [], "ergaenzt": [], "status": "nicht_anwendbar"}, "rueckfrage": true, "unvollstaendig": true, "tokens": {"prompt_tokens": 3066, "output_tokens": 299, "versuche": 1, "modell": "gemini-3.1-flash-lite"}, "dauer_s": 3.94}
