{"zeit": "2026-10-03T10:36:22", "pseudonym": "8b2a8a86294bfc1ed679762b76613545", "frage_id": "D03", "sprache": "de", "modell": "gemini-3.1-flash-lite", "reranker": null, "k": 10, "entscheid": "beantwortet", "antwort": "Die Gebühr für das nächtliche Dauerparkieren auf öffentlichem Grund zwischen 22.00 und 07.00 Uhr ist abhängig vom Fahrzeugtyp: Für leichte Motorwagen unter 3,5 t (Kategorie B) sowie Anhänger und dreirädrige Motorfahrzeuge beträgt die monatliche Gebühr CHF 30.00 (SRS 7.7.5-2 § 10 Abs. 3 lit. a; [Q4]). Für schwere Motorwagen über 3,5 t sowie Anhänger für schwere Motorwagen beträgt die Gebühr CHF 60.00 pro Monat (SRS 7.7.5-2 § 10 Abs. 3 lit. b).", "quellen": ["web:de/mobilitaet/parkieren#12", "law:7.7.5-2#9", "law:7.7.5-2#12", "web:de/mobilitaet/parkieren#13", "web:de/mobilitaet/parkieren#7", "pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#24", "pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#89", "pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#75", "pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#56", "pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#13"], "benutzte_quellen": ["web:de/mobilitaet/parkieren#12", "law:7.7.5-2#9", "web:de/mobilitaet/parkieren#13"], "s1": 0.5724, "s2": 1.0, "s3": 1.0, "confidence_vorlaeufig": 0.8717, "grounding_urteil": "gedeckt", "grounding_grund": "beide_schichten", "coverage": {"ok": true, "typen": ["gebuehr"], "luecken": [], "nur_eine_quellenart": false, "quellenarten_mit_betrag": ["erlass", "web"]}, "coverage_ergaenzung": {"typen": ["gebuehr"], "ergaenzt": [], "status": "beide_arten_vorhanden"}, "rueckfrage": false, "unvollstaendig": false, "tokens": {"prompt_tokens": 4327, "output_tokens": 229, "versuche": 1, "modell": "gemini-3.1-flash-lite"}, "dauer_s": 3.87}
