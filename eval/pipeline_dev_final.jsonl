{"zeit": "2026-10-03T10:49:41", "pseudonym": "9872d3140523b92b1c648eeea07ab13c", "frage_id": "D02", "sprache": "de", "modell": "gemini-3.1-flash-lite", "reranker": null, "k": 10, "entscheid": "beantwortet", "antwort": "Die Kosten für eine Stunde Parkieren in der Stadt Zug hängen von der Art des Parkplatzes ab: Für Kurzzeitparkplätze gelten gemäss SRS 7.7.5-2 § 7 je nach Standort unterschiedliche Tarife: an zentrumsnahen Standorten CHF 2.00 pro Stunde und an peripheren Standorten CHF 1.00 pro Stunde. Auf Langzeitparkplätzen beträgt die Gebühr pro Stunde bis maximal 8 Stunden CHF 1.00 (SRS 7.7.5-2 § 6). Zudem gibt es auf der Webseite «Parkieren auf dem Stadtgebiet» unter «Tarife» eine weitere Gebührenübersicht für Kurzzeittarife, die mit CHF 1.50 für die erste Stunde beginnt. Da diese Angaben zu den Kurzzeitparkplätzen voneinander abweichen, wenden Sie sich für eine verbindliche Auskunft bitte an die zuständige Stelle.", "quellen": ["web:de/mobilitaet/parkieren#0", "web:de/mobilitaet/parkieren#8", "pdf:dam_jcr_1477b3b8_f5dc_428b_8803_b9c7ecf1aadf_Taxipr_C3_BCfung_Brosch_C3_BCre_A4__2ee245.pdf#5", "pdf:dam_jcr_1477b3b8_f5dc_428b_8803_b9c7ecf1aadf_Taxipr_C3_BCfung_Brosch_C3_BCre_A4__2ee245.pdf#3", "law:7.7.5-2#5", "law:7.7.5-2#12", "law:7.7.5-1#1", "web:de/mobilitaet/parkieren#2", "law:7.7.5-2#6", "pdf:dam_jcr_5fa9a780_67c0_41af_a208_a30b1c81da83_Broschuere_Anschluss_finden_pdf_6debce.pdf#7", "pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#10", "web:de/mobilitaet/parkieren#9"], "bm25_nachzug": ["pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#10", "web:de/mobilitaet/parkieren#9"], "benutzte_quellen": ["law:7.7.5-2#5", "web:de/mobilitaet/parkieren#2", "law:7.7.5-2#6"], "s1": 0.6345, "s2": 1.0, "s3": 0.8, "confidence_vorlaeufig": 0.8304, "grounding_urteil": "gedeckt", "grounding_grund": "beide_schichten", "coverage": {"ok": true, "typen": ["gebuehr"], "luecken": [], "nur_eine_