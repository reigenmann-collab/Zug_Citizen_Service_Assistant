{"zeit": "2026-10-03T10:53:41", "pseudonym": "f343b7f583364745d1249ba171f76869", "frage_id": "D24", "sprache": "en", "modell": "gemini-3.1-flash-lite", "reranker": null, "k": 10, "entscheid": "beantwortet", "antwort": "The monthly fee for a resident parking permit depends on whether the night parking fee is already paid: 1. If the night parking fee is already paid, the fee for a resident parking permit is CHF 30.00 per month (SRS 7.7.5-2 § 12). 2. If the night parking fee is included, the fee for a resident parking permit is CHF 60.00 per month (SRS 7.7.5-2 § 12). Additionally, the website 'Parkieren auf dem Stadtgebiet' states a fee of CHF 30.- per month for resident parking permits (Parkieren auf dem Stadtgebiet – Parkieren auf dem Stadtgebiet > Parkkarten für Anwohnende in den Quartieren).\n\nPlease note: this English answer is not legally binding. The official language of the City of Zug is German; the German sources cited above are authoritative.", "quellen": ["law:7.7.5-2#12", "law:7.7.5-1#3", "web:de/mobilitaet/parkieren#3", "web:de/mobilitaet/parkieren#2", "law:7.7.5-2#14", "law:7.7.5-2#11", "law:7.7.5-2#9", "law:7.7.5-2#7", "law:7.7.5-2#6", "web:de/mobilitaet/parkieren#6", "web:de/mobilitaet/parkieren#8", "pdf:dam_jcr_6435dcdb_0c5c_4a65_b197_9b22a73fc83e_Konzept_Schulwegsicherheit_Basler_H_33e4c6.pdf#23"], "bm25_nachzug": ["web:de/mobilitaet/parkieren#8", "pdf:dam_jcr_6435dcdb_0c5c_4a65_b197_9b22a73fc83e_Konzept_Schulwegsicherheit_Basler_H_33e4c6.pdf#23"], "benutzte_quellen": [], "s1": 0.729, "s2": 1.0, "s3": 1.0, "confidence_vorlaeufig": 0.9187, "grounding_urteil": "gedeckt", "grounding_grund": "beide_schichten", "coverage": {"ok": true, "typen": ["gebuehr"], "luecken": [], "nur_eine_quellenart": false, "quellenarten_mit_betrag": ["erlass", "web"]}, "coverage_ergaenzung": {"typen": ["gebuehr"], "ergaenzt": [], "status": "beide_arten_vorhanden"}, "rueckfrage": false, "unvollstaendig": false, "tokens": {"prompt_tokens": 3852, "output_tokens": 299, "versuche"