{"zeit": "2026-10-03T10:50:04", "pseudonym": "57c8f387c4824e600e0812e09349c602", "frage_id": "D04", "sprache": "de", "modell": "gemini-3.1-flash-lite", "reranker": null, "k": 10, "entscheid": "beantwortet", "antwort": "Anwohnerparkkarten werden für die folgenden zehn Zonen in der Stadt Zug ausgegeben: Zone 1 (Altstadt), Zone 2 (Neustadt), Zone 3 (Oberwil), Zone 4 (Gimenen), Zone 5 (St. Michael), Zone 6 (Rosenberg), Zone 7 (Loreto), Zone 8 (Guthirt), Zone 9 (Herti) und Zone 10 (Lorzen) (SRS 7.7.5-2 § 10). Bitte beachten Sie, dass für die Zone 4 keine Parkkarten erhältlich sind (Parkkarten für Anwohnende in den Quartieren).", "quellen": ["web:de/mobilitaet/parkieren#4", "web:de/mobilitaet/parkieren#3", "pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#20", "law:7.7.5-2#19", "web:de/mobilitaet/parkieren#5", "law:7.7.5-2#13", "law:7.7.5-2#15", "web:de/mobilitaet/parkieren#0", "pdf:dam_jcr_d3b55345_c840_492f_9111_5c096b44feb9_Ratgeber_fur_die_Installation_von_L_c97f26.pdf#75", "law:7.7.5-2#10", "pdf:dam_jcr_5fa9a780_67c0_41af_a208_a30b1c81da83_Broschuere_Anschluss_finden_pdf_6debce.pdf#1", "law:7.7.5-2#17"], "bm25_nachzug": ["pdf:dam_jcr_5fa9a780_67c0_41af_a208_a30b1c81da83_Broschuere_Anschluss_finden_pdf_6debce.pdf#1", "law:7.7.5-2#17"], "benutzte_quellen": ["web:de/mobilitaet/parkieren#3", "law:7.7.5-2#10"], "s1": 0.7082, "s2": 1.0, "s3": 1.0, "confidence_vorlaeufig": 0.9125, "grounding_urteil": "gedeckt", "grounding_grund": "beide_schichten", "coverage": {"ok": true, "typen": [], "luecken": [], "nur_eine_quellenart": false, "quellenarten_mit_betrag": ["erlass", "web"]}, "coverage_ergaenzung": {"typen": [], "ergaenzt": [], "status": "nicht_anwendbar"}, "rueckfrage": false, "unvollstaendig": false, "tokens": {"prompt_tokens": 5210, "output_tokens": 206, "versuche": 1, "modell": "gemini-3.1-flash-lite"}, "dauer_s": 3.09}
